generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

model Tenant {
  id String @id @default(uuid())
  name String 
  createdAt DateTime @default(now())

  workspaces Workspace[]
  users User[]
}

model User {
  id String @id @default(uuid())
  email String @unique
  password String
  name String
  role Role @default(MEMBER)
  createdAt DateTime @default(now())

  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id])

  assignedTasks Task[]
}

model Workspace {
  id String @id @default(uuid())
  name String
  createdAt DateTime @default(now())

  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id])

  boards Board[]
}

model Board {
  id String @id @default(uuid())
  name String
  createdAt DateTime @default(now())

  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id])

  lists List[]
}

model List{
  id String @id @default(uuid())
  name String
  order Int

  boardId String
  board Board @relation(fields: [boardId],references: [id])

  tasks Task[]
}

model Task {
  id String @id @default(uuid())
  title String
  description String?
  order Int
  dueDate DateTime?
  createdAt DateTime @default(now())

  listId String
  list List @relation(fields: [listId], references: [id])

  assigneeId String?
  assignee User? @relation(fields: [assigneeId], references: [id])
}